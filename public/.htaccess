Options -MultiViews
DirectoryIndex index.html
RewriteEngine On

# Serve exported assets and directories directly.
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Serve Expo's exported pages at their extensionless URLs.
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+?)/?$ $1.html [L]

# Dynamic detail pages share their exported route template.
RewriteRule ^suites/[^/]+/?$ suites/[id].html [L]
RewriteRule ^shop/[^/]+/?$ shop/[id].html [L]

# Let the app render its missing-page screen for unknown routes.
RewriteRule ^ index.html [L]
